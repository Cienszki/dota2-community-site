# Copy to .env.local and fill in. Never commit the filled-in file.
#
# The site talks to TWO databases, and the split matters:
#   Supabase  — our own content: news, ranking, hall of fame, basher, admin
#   Firestore — the LOBBY BOT's database, shared as the whole integration seam
#
# Nothing under /inhouse, /admin/inhouse or /players works without the Firestore
# key. Those pages render an "unavailable" state rather than crashing, so a
# missing key looks like a working site with no games in it.

# ── Supabase — our content ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firestore — the bot's database ──────────────────────────────────────────
# DO NOT create a new Firebase project. Ask whoever runs the lobby bot for a
# service-account key from the project it ALREADY uses; a fresh project means an
# empty database and every inhouse page correctly showing nothing.
#
#   node -e "console.log(Buffer.from(require('fs').readFileSync('service-account.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Identity ────────────────────────────────────────────────────────────────
# Discord OAuth app. Scopes: identify, connections, guilds.members.read.
# The redirect URI must match NEXT_PUBLIC_SITE_URL exactly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Signs the Steam and Discord session cookies. Any long random string, but
# changing it logs everybody out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PDL_SESSION_SECRET=

# Public origin, e.g. https://pd2ih.pl — must equal the bot's own SITE_URL.
# www/non-www drift breaks both Steam OpenID and the Discord redirect.
NEXT_PUBLIC_SITE_URL=

# ── Bot integration ─────────────────────────────────────────────────────────
# Shared secret for the lobby bot's match-finished webhook. Same value on both
# sides. Unset = the endpoint 401s everything, which is the safe default.
INHOUSE_BOT_WEBHOOK_SECRET=

# Bearer token for the /api/cron/* routes.
CRON_SECRET=

# ── External APIs ───────────────────────────────────────────────────────────
# OpenDota is the source for match results. A key only raises the rate limit;
# unset works fine at this volume.
OPENDOTA_API_KEY=
# OPENDOTA_BASE_URL=https://api.opendota.com/api

# Steam Web API, used by the vendored bot core.
STEAM_API_KEY=
# STEAM_API_BASE_URL=

STRATZ_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Site admin ──────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin. Everyone else gets a 403 page.
ADMIN_EMAILS=

# ── Mail (contact form) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── Misc ────────────────────────────────────────────────────────────────────
GITHUB_ACCESS_TOKEN=
# LOG_LEVEL=info
